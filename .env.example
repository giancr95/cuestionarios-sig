# Copiar a .env y completar en producción (en Coolify: Environment Variables).

# Clave para firmar cookies de sesión. OBLIGATORIA en producción.
# Generar, por ejemplo, con:  openssl rand -hex 32
SESSION_SECRET=

# Puerto interno del contenedor (Coolify hace el proxy).
PORT=3000

# Directorio donde vive la BD SQLite. En Docker, dejar /data (es un volumen).
DATA_DIR=/data

# Entorno. En Coolify poner "production" — hace que la cookie sea secure y
# exige SESSION_SECRET.
NODE_ENV=production

# Contraseñas sembradas la PRIMERA vez que arranca la BD (si users está vacía).
# Después, cámbielas desde la BD; estas variables se ignoran.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
